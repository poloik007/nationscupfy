rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'admin@yourdomain.com';
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
